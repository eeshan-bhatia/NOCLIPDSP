# Optional test-only toolchain. Production JUCE builds use MSVC + Windows SDK.
set(CMAKE_SYSTEM_NAME Windows)
get_filename_component(NOCLIP_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(CMAKE_C_COMPILER "${NOCLIP_ROOT}/.tools/python/ziglang/zig.exe")
set(CMAKE_C_COMPILER_ARG1 "cc")
set(CMAKE_CXX_COMPILER "${NOCLIP_ROOT}/.tools/python/ziglang/zig.exe")
set(CMAKE_CXX_COMPILER_ARG1 "c++")
set(CMAKE_C_COMPILER_TARGET x86_64-windows-gnu)
set(CMAKE_CXX_COMPILER_TARGET x86_64-windows-gnu)
set(CMAKE_AR "${NOCLIP_ROOT}/.tools/python/ziglang/zig.exe")
set(CMAKE_C_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_CXX_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_ARCHIVE_FINISH "<CMAKE_AR> ar s <TARGET>")
set(CMAKE_CXX_ARCHIVE_FINISH "<CMAKE_AR> ar s <TARGET>")
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/zig-rules.cmake")
